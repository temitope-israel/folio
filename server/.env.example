# server/.env.example
# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in the values.
# This file IS committed to Git — it shows what variables are
# needed without exposing the actual secret values.
# ============================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/folio_db
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
JWT_SECRET=
ADMIN_PASSWORD=